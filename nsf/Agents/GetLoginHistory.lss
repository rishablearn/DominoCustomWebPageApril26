'===========================================================================
' GetLoginHistory.lss  -  Agent "GetLoginHistory"  (LOGINAUDIT.NSF)
'
' Version  : 3.1.1
' History  : replaces v1.0.0, which read names.nsf
' Requires : HCL Domino 12.0.1+, script library LoginAuditLib
'
' WHAT IT DOES
' ------------
' Returns the caller's last MAX_HISTORY_SHOWN (5) SUCCESSFUL logins as JSON
' for the HCL Verse "Login Activity" viewer.
'
' SECURITY
'   * Caller = server-set Remote_User, normalised to canonical name.
'   * Lookup is an EXACT key match on the canonical name in (LoginsByUser).
'     (v1.0.0 used a partial match, which could return another user's data.)
'   * No user-controlled input is accepted at all.
'   * Anonymous -> {"ok":false,"reason":"auth","events":[]}
'
' RESPONSE
' {
'   "ok": true, "user": "Scott Good", "retentionDays": 365,
'   "events": [
'     { "id":"<UNID>", "loginTime":"2026-10-28T08:00:00Z",
'       "ip":"203.0.113.9", "browser":"Chrome", "os":"Windows",
'       "deviceType":"Desktop", "accessSource":"HCL Verse (web)",
'       "authMethod":"Domino password", "firstLogin":false,
'       "newIp":true, "newDevice":false, "notMe":false,
'       "thisDevice":true,
'       "sessionState":"active|ended|unmeasured", "durationSec":1260 or null }
'   ]
' }
'
' AGENT PROPERTIES: On Schedule -> Never; act on None; Run as web user UNCHECKED;
'                   signed by the service ID (member of LocalDomainAdmins).
'===========================================================================
Option Public
Option Declare
Use "LoginAuditLib"

Sub Initialize()
    Dim session As New NotesSession
    Dim web     As NotesDocument
    Dim db      As NotesDatabase
    Dim view    As NotesView
    Dim vec     As NotesViewEntryCollection
    Dim entry   As NotesViewEntry
    Dim doc     As NotesDocument
    Dim caller  As String
    Dim ua      As String
    Dim reqIp   As String
    Dim reqKey  As String
    Dim nowDt   As NotesDateTime
    Dim n       As Integer
    Dim items() As String
    Dim nn      As NotesName

    Call PrintJsonHeaders()
    On Error GoTo ErrHandler

    Set web = session.DocumentContext
    Set db = session.CurrentDatabase

    caller = GetCaller(web, session)
    If caller = "" Then
        Print |{"ok":false,"reason":"auth","events":[]}|
        Exit Sub
    End If

    ua     = CleanText(GetCgi(web, "HTTP_USER_AGENT"), 300)
    reqIp  = GetClientIp(web)
    reqKey = MakeDeviceKey(ParseBrowser(ua), ParseOS(ua), ParseDeviceType(ua))

    Set nowDt = New NotesDateTime("")
    Call nowDt.SetNow

    Set view = db.GetView(VIEW_BY_USER)
    If view Is Nothing Then Error 1001, "View " & VIEW_BY_USER & " not found"

    ReDim items(MAX_HISTORY_SHOWN - 1)
    Set vec = view.GetAllEntriesByKey(caller, True)       ' exact canonical match
    If Not (vec Is Nothing) Then
        Set entry = vec.GetFirstEntry()                    ' newest first
        Do While Not (entry Is Nothing)
            If n >= MAX_HISTORY_SHOWN Then Exit Do
            Set doc = entry.Document
            If Not (doc Is Nothing) Then
                items(n) = EventToJson(doc, reqIp, reqKey, nowDt)
                n = n + 1
            End If
            Set entry = vec.GetNextEntry(entry)
        Loop
    End If

    Set nn = session.CreateName(caller)

    Dim body As String
    If n = 0 Then
        body = ""
    Else
        ReDim Preserve items(n - 1)
        body = Join(items, ",")
    End If

    Print "{" & JRaw("ok", "true") & "," & JStr("user", nn.Common) & "," & _
          JRaw("retentionDays", CStr(RETENTION_DAYS)) & "," & _
          JRaw("events", "[" & body & "]") & "}"
    Exit Sub

ErrHandler:
    Call LogAuditError(session, db, "GetLoginHistory", Err, Erl, Error$)
    Print |{"ok":false,"reason":"error","events":[]}|
    Exit Sub
End Sub

'---------------------------------------------------------------------------
Function EventToJson(doc As NotesDocument, ByVal reqIp As String, ByVal reqKey As String, _
                     nowDt As NotesDateTime) As String
    Dim loginDt As NotesDateTime
    Dim lastDt  As NotesDateTime
    Dim endDt   As NotesDateTime
    Dim hb      As Long
    Dim state   As String
    Dim durSec  As Long
    Dim durJson As String

    Set loginDt = GetDt(doc, "LoginTime")
    Set lastDt  = GetDt(doc, "LastSeen")
    Set endDt   = GetDt(doc, "EndTime")
    hb = ItemNum(doc, "Heartbeats")

    durJson = "null"
    state = "unmeasured"

    If Not (loginDt Is Nothing) Then
        If Not (endDt Is Nothing) Then
            state = "ended"
            durSec = endDt.TimeDifference(loginDt)
            If durSec >= 0 Then durJson = CStr(durSec)
        ElseIf (hb > 0) And Not (lastDt Is Nothing) Then
            durSec = lastDt.TimeDifference(loginDt)
            If durSec >= 0 Then durJson = CStr(durSec)
            If nowDt.TimeDifference(lastDt) <= ACTIVE_WINDOW_MIN * 60 Then
                state = "active"
            Else
                state = "ended"
            End If
        End If
    End If

    EventToJson = "{" & _
        JStr("id", doc.UniversalID) & "," & _
        JStr("loginTime", ItemStr(doc, "LoginTimeUTC")) & "," & _
        JStr("ip", ItemStr(doc, "IP")) & "," & _
        JStr("browser", ItemStr(doc, "Browser")) & "," & _
        JStr("os", ItemStr(doc, "OS")) & "," & _
        JStr("deviceType", ItemStr(doc, "DeviceType")) & "," & _
        JStr("accessSource", ItemStr(doc, "AccessSource")) & "," & _
        JStr("authMethod", ItemStr(doc, "AuthMethod")) & "," & _
        JRaw("firstLogin", JBool(ItemStr(doc, "FirstLogin") = "1")) & "," & _
        JRaw("newIp", JBool(ItemStr(doc, "NewIP") = "1")) & "," & _
        JRaw("newDevice", JBool(ItemStr(doc, "NewDevice") = "1")) & "," & _
        JRaw("notMe", JBool(ItemStr(doc, "NotMeFlag") = "1")) & "," & _
        JRaw("thisDevice", JBool((ItemStr(doc, "IP") = reqIp) And (ItemStr(doc, "DeviceKey") = reqKey))) & "," & _
        JStr("sessionState", state) & "," & _
        JRaw("durationSec", durJson) & _
        "}"
End Function
